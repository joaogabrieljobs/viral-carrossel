# Copie este arquivo para `.env.local` e preencha com suas chaves.
# (.env.local é ignorado pelo git e nunca enviado para o repositório.)

# OBRIGATÓRIA — texto incluso no plano (Z.ai no servidor via /api/ai/compatible).
# Modelos permitidos com esta chave: shared/ai-models.js (PLATFORM_TEXT_MODELS).
# ZAI_API_KEY=...

# OPCIONAL — Kimi/Moonshot no servidor (mesmo proxy).
# KIMI_API_KEY=...

# SÓ DEV — usada apenas pelo proxy do Vite (vite.config.js) para testar Claude
# sem colar a chave no browser. O endpoint de produção /api/anthropic/v1/messages
# ignora esta env e exige o header x-anthropic-key (Claude é BYOK desde 2026-09-15:
# com fallback do host, qualquer assinante gastava Opus na conta da plataforma).
# ANTHROPIC_API_KEY=sk-ant-...

# OPCIONAL (só dev) — OpenAI para o proxy do Vite quando não há chave no header.
# Em produção a chave OpenAI do utilizador vai direto do browser (BYOK).
# OPENAI_API_KEY=sk-proj-...

# ─── Stripe (assinatura individual do studio) ───────────────────────────────
# URL pública do app (sem barra final). Produção: domínio próprio ou Vercel.
# APP_URL=https://viralcarrossel.com.br
# APP_URL=https://viral-carrossel.vercel.app

# Chave secreta Stripe (Dashboard → Developers → API keys)
# STRIPE_SECRET_KEY=sk_test_...

# Price ID do plano mensal R$97 (Products → Viral. Studio → Price)
# STRIPE_PRICE_ID=price_...

# Webhook signing secret (endpoint: /api/stripe/webhook)
# Eventos: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# STRIPE_WEBHOOK_SECRET=whsec_...

# Segredo para assinar o cookie de acesso (qualquer string longa aleatória)
# ACCESS_COOKIE_SECRET=troque-por-uma-string-longa-e-aleatoria

# ─── Google login (quem já assina) ───────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URI: https://SEU_DOMINIO/api/auth/google/callback
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# (opcional) override do redirect:
# GOOGLE_REDIRECT_URI=https://viralcarrossel.com.br/api/auth/google/callback

# DEV ONLY — libera o studio sem Stripe (nunca em production)
# BILLING_DISABLED=true

# ─── SJinn (imagens GPT Image 2 — plataforma; só servidor) ───────────────────
# Conta: https://sjinn.ai — Tool API → gpt-image-2-api (100 créditos/imagem)
# Spike local: node --env-file=.env.local scripts/spike-sjinn-image.mjs
# NUNCA expor no browser / VITE_*.
# SJINN_API_KEY=...

# ─── Planos Stripe (4 prices) — ver docs/product/PRD-planos-imagem-sjinn.md ──
# STRIPE_PRICE_ID_ESSENTIAL=price_...   # R$ 19,90 · 0 imagens
# STRIPE_PRICE_ID_CREATOR=price_...     # R$ 97 · 50 imagens (ou legado STRIPE_PRICE_ID)
# STRIPE_PRICE_ID_PRO=price_...         # R$ 197 · 150 imagens
# STRIPE_PRICE_ID_MAX=price_...         # R$ 297 · 300 imagens
# STRIPE_PRICE_ID=price_...             # legado → tratado como creator

# ─── Quota de imagens (produção) — Upstash Redis REST ───────────────────────
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
