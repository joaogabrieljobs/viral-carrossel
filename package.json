{
  "name": "viral-carrossel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Moont — studio de narrativas visuais com IA para comunicação e apresentações",
  "scripts": {
    "dev": "vite",
    "build:presentation-design-system": "node scripts/build-presentation-design-system.mjs",
    "prebuild": "npm run build:presentation-design-system",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "npm run check:undef && npm run check:props && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:undef": "node scripts/check-undefined.mjs",
    "check:props": "node scripts/check-props.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "desktop:check": "./scripts/build-desktop.sh --so-conferir",
    "desktop:dev": "./scripts/build-desktop.sh --dev",
    "desktop:build": "./scripts/build-desktop.sh"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.3",
    "gsap": "^3.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.383.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smartcrop": "2.0.5",
    "stripe": "^22.3.2",
    "tesseract.js": "^6.0.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
